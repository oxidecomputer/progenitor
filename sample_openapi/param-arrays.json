{
  "openapi": "3.0.3",
  "info": {
    "title": "Parameter Arrays",
    "description": "Header and query parameters whose schema is an array",
    "version": "v1"
  },
  "paths": {
    "/things": {
      "get": {
        "operationId": "list_things",
        "parameters": [
          {
            "in": "query",
            "name": "kinds",
            "description": "kinds of thing to include",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ThingKind"
              }
            }
          },
          {
            "in": "query",
            "name": "tags",
            "description": "tags that each thing must have",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "in": "header",
            "name": "x-labels",
            "description": "labels for the request",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "in": "header",
            "name": "x-shard-ids",
            "description": "shards to read from",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint32"
              }
            }
          },
          {
            "in": "header",
            "name": "x-codes",
            "description": "codes whose items are constrained strings",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z]+$"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ThingKind": {
        "type": "string",
        "enum": [
          "widget",
          "gadget"
        ]
      }
    }
  }
}
